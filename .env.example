APP_NAME=Emdadyar
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Set a long random value in real environments.
SECRET_KEY=replace-with-a-long-random-secret

# SQLite database path (local file)
DATABASE_URL=sqlite:///./emdadyar.db

# File upload root directory (relative to project root or absolute path)
UPLOADS_DIR=uploads

# Bale bot token from @botfather
BALE_BOT_TOKEN=replace-with-your-bale-token

# Initial admin bootstrap (preferred variable names)
ADMIN_USERNAME=replace-admin-username
ADMIN_PASSWORD=replace-admin-password

# Backward-compatible fallback names (optional)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Session cookie settings
# Use true behind HTTPS in deployment; keep false for local HTTP development.
SESSION_COOKIE_SECURE=false
# Allowed: lax, strict, none
SESSION_COOKIE_SAMESITE=lax
